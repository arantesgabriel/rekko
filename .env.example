# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL / Supabase local (`pnpm supabase:status` shows the current URL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
REKKO_SEED_ENV=local

# Authentication (use a random secret with at least 32 characters outside local development)
BETTER_AUTH_SECRET=local-development-secret-change-me-now
BETTER_AUTH_URL=http://localhost:3000
EMAIL_VERIFICATION_GRACE_HOURS=72

# Google OAuth (optional locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (optional locally; without it links are written to the server log)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rekko <onboarding@resend.dev>

# Sentry (optional locally)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog (optional; analytics is best-effort)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
