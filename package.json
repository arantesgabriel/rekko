{
  "name": "rekko",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reconstrua seu tempo. Entenda sua jornada.",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @rekko/web dev",
    "build": "pnpm --filter @rekko/web build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @rekko/db db:generate",
    "db:migrate": "pnpm --filter @rekko/db db:migrate",
    "db:seed": "pnpm --filter @rekko/db db:seed",
    "db:studio": "pnpm --filter @rekko/db db:studio",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.0.0",
    "supabase": "2.115.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
